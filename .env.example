# Database Configuration
# Local SQLite (Development):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Hostinger VPS / Cloud DB):
# DATABASE_URL="postgresql://username:password@localhost:5432/scalemint_production?schema=public"

# Authentication Secret (Generate a 32+ char random string)
JWT_SECRET="replace-with-ultra-secure-random-token"

# Default Admin Credentials for First-Time Safe Initialization
ADMIN_DEFAULT_EMAIL="admin@scalemint.com"
ADMIN_DEFAULT_PASSWORD="YourSecurePasswordHere!"

# Public Base URL
NEXT_PUBLIC_APP_URL="https://youragencydomain.com"
